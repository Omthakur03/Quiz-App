          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8001/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8001",
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Quiz Service Direct Health Check (Port 8002)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8002",
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Result Service Direct Health Check (Port 8003)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8003/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8003",
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
