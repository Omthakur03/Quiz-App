# Quiz Service Environment Variables

# Server Configuration
PORT=8002

# AWS / DynamoDB Configuration
AWS_REGION=us-east-1
# Set DYNAMODB_ENDPOINT to http://localhost:8000 for local DynamoDB testing.
# Remove or leave empty to connect to actual AWS DynamoDB service in cloud.
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS Credentials (Required for AWS Cloud, dummy credentials accepted by DynamoDB Local)
AWS_ACCESS_KEY_ID=fakeAccessKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey

# Table Names
QUESTIONS_TABLE=QuestionsTable
